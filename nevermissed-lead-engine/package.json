{
  "name": "nevermissed-lead-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Internal sales tool: find salons, test whether they miss calls, score them, and run outreach for the NeverMissed AI Receptionist.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "jobs:emails": "tsx --conditions=react-server scripts/run-job.ts emails",
    "jobs:enrich": "tsx --conditions=react-server scripts/run-job.ts enrich",
    "jobs:refresh-places": "tsx --conditions=react-server scripts/run-job.ts refresh-places",
    "jobs:imap": "tsx --conditions=react-server scripts/run-job.ts imap",
    "jobs:automated-calls": "tsx --conditions=react-server scripts/run-job.ts automated-calls",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx prisma/seed-if-empty.ts && next build",
    "jobs:sourcing": "tsx --conditions=react-server scripts/run-job.ts sourcing",
    "jobs:planner": "tsx --conditions=react-server scripts/run-job.ts planner"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.8.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@twilio/voice-sdk": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^2.12.2",
    "inngest": "^4.27.0",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.78.0",
    "luxon": "^3.7.2",
    "mailparser": "^3.15.0",
    "next": "^15.5.29",
    "papaparse": "^5.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "twilio": "^6.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
