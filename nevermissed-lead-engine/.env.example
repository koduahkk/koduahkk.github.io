# ─── Required ──────────────────────────────────────────────────────────────
# Postgres (Supabase: Settings → Database → Connection string).
# DATABASE_URL = pooled (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (5432) for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nevermissed"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nevermissed"

# Public URL of the app (used in unsubscribe links, tracking, Twilio callbacks).
APP_URL="http://localhost:3000"

# 32+ random characters. Encrypts API keys saved in Settings and signs links/cookies.
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ─── Auth (pick one) ───────────────────────────────────────────────────────
# Supabase Auth (production): magic-link sign-in.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Demo mode: pick a seeded user on the login page. Ignored in production
# unless ALLOW_DEMO_IN_PRODUCTION=true. Never enable on a real deployment.
DEMO_MODE="true"
ALLOW_DEMO_IN_PRODUCTION="false"

# ─── Background jobs (Inngest) ─────────────────────────────────────────────
# Local: run `npm run inngest:dev` and set INNGEST_DEV=1. Production: from the Inngest dashboard.
INNGEST_DEV="1"
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Time zone the 7:00am planner and 3:00am Places refresh run in.
PLANNER_CRON_TZ="America/New_York"

# ─── Integrations (optional; can also be saved encrypted in Settings → Integrations) ───
GOOGLE_PLACES_API_KEY=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# A Twilio number you own, E.164, e.g. +14045550100
TWILIO_CALLER_ID=""
# Browser calling only (Voice JS SDK):
TWILIO_API_KEY=""
TWILIO_API_SECRET=""
TWILIO_TWIML_APP_SID=""

# Email: choose the provider in Settings → Email.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
SENDGRID_API_KEY=""
SENDGRID_WEBHOOK_PUBLIC_KEY=""
# Shared secret for /api/webhooks/email/inbound?token=...
INBOUND_WEBHOOK_TOKEN=""

# Optional IMAP reply polling (alternative to inbound webhooks).
IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
