{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "app.lumen.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "onboarding",
        "title": "Welcome to Lumen",
        "url": "index.html#/onboarding",
        "width": 600,
        "height": 700,
        "resizable": false,
        "center": true,
        "visible": false,
        "contentProtected": false
      },
      {
        "label": "panel",
        "title": "Lumen",
        "url": "index.html#/panel",
        "width": 380,
        "height": 520,
        "minWidth": 300,
        "minHeight": 240,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "contentProtected": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI answers for what's on your screen and in your meetings",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
